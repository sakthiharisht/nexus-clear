# Copy to .env (gitignored) and fill in for local/live runs.
# docker-compose.yml sets DATABASE_URL itself for the containerized backend;
# this file is for running the backend directly on the host (uv run uvicorn ...).

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nexus_clear

# Optional. Read directly from the environment by the anthropic/httpx
# SDKs, not by app.core.config.Settings - only needed to run
# tests/backends/test_live_smoke.py (auto-skipped without it) or
# app/eval/live_classify.py (never run automatically; real cost).
ANTHROPIC_API_KEY=
JEV_API_KEY=
